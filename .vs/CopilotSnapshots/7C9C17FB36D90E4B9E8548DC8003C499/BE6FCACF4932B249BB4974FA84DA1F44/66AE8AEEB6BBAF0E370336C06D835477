void Menu::menuCentros() {
    limpiarPantalla();
    int opcion;
    do {
        cout << "\nCENTROS\n1 Registrar\n2 Buscar\n3 Mostrar todos\n4 Eliminar\n0 Regresar\n";
        opcion = leerEntero("Opcion: ");
        if (opcion == 1) {
            string codigo = leerTexto("Codigo: ");
            if (sistema->buscarCentro(codigo) != nullptr) { cout << "Codigo duplicado." << endl; continue; }
            CentroDistribucion* centro = new CentroDistribucion(codigo,
                leerTexto("Nombre: "), leerTexto("Provincia: "),
                leerTexto("Direccion: "), leerTexto("Telefono: "));
            if (!sistema->agregarCentro(centro)) delete centro;
        }
        else if (opcion == 2) { CentroDistribucion* c = seleccionarCentro(); if (c != nullptr) c->mostrar(); }
        else if (opcion == 3) sistema->mostrarEstado();
        else if (opcion == 4) {
            string codigo = leerTexto("Codigo del centro: ");
            cout << (sistema->eliminarCentro(codigo) ? "Centro eliminado." : "No se puede eliminar el centro.") << endl;
        }
    } while (opcion != 0);
    limpiarPantalla();
}

void Menu::menuClientes() {
    limpiarPantalla();
    CentroDistribucion* centro = seleccionarCentro();
    if (centro == nullptr) return;
    int opcion;
    do {
        cout << "\nCLIENTES\n1 Registrar persona fisica\n2 Registrar empresa\n3 Buscar\n4 Mostrar\n5 Eliminar\n0 Regresar\n";
        opcion = leerEntero("Opcion: ");
        if (opcion == 1 || opcion == 2) {
            string id = leerTexto("Identificacion: ");
            if (centro->buscarCliente(id) != nullptr) { cout << "Identificacion duplicada." << endl; continue; }
            string nombre = leerTexto("Nombre: ");
            string telefono = leerTexto("Telefono: ");
            string correo = leerTexto("Correo: ");
            if (!Validador::correoValido(correo)) { cout << "Correo invalido." << endl; continue; }
            Cliente* cliente;
            if (opcion == 1) cliente = new PersonaFisica(id, nombre, telefono, correo);
            else {
                string actividad = leerTexto("Actividad economica: ");
                double descuento = leerDecimal("Descuento (0-100): ");
                if (!Empresa::esPorcentajeValido(descuento)) { cout << "Descuento invalido." << endl; continue; }
                cliente = new Empresa(id, nombre, telefono, correo, actividad, descuento);
            }
            if (!centro->agregarCliente(cliente)) delete cliente;
        }
        else if (opcion == 3) { Cliente* c = centro->buscarCliente(leerTexto("Identificacion: ")); if (c != nullptr) c->mostrar(); }
        else if (opcion == 4) for (Nodo<Cliente>* n = centro->getClientes().getPrimero(); n != nullptr; n = n->getSiguiente()) n->getDato()->mostrar();
        else if (opcion == 5) cout << (centro->eliminarCliente(leerTexto("Identificacion: ")) ? "Cliente eliminado." : "No se puede eliminar.") << endl;
    } while (opcion != 0);
    limpiarPantalla();
}

