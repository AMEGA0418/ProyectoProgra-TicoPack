int Menu::leerEntero(const string& mensaje) const {
    int valor;
    while (true) {
        cout << mensaje;
        cin >> valor;
        if (!cin.fail()) {
            cin.ignore(10000, '\n');
            return valor;
        }
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Debe ingresar un numero entero." << endl;
    }
}

double Menu::leerDecimal(const string& mensaje) const {
    double valor;
    while (true) {
        cout << mensaje;
        cin >> valor;
        if (!cin.fail()) {
            cin.ignore(10000, '\n');
            return valor;
        }
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Debe ingresar un numero valido." << endl;
    }
}

Fecha Menu::leerFecha(const string& mensaje) const {
    while (true) {
        cout << mensaje << endl;
        int dia = leerEntero("Dia: ");
        int mes = leerEntero("Mes: ");
        int anio = leerEntero("Anio: ");
        int hora = leerEntero("Hora (0-23): ");
        int minuto = leerEntero("Minuto (0-59): ");
        Fecha fecha(dia, mes, anio, hora, minuto);
        if (fecha.esValida()) return fecha;
        cout << "La fecha no es valida." << endl;
    }
}

CentroDistribucion* Menu::seleccionarCentro() const {
    if (sistema == nullptr || sistema->getCentros().estaVacia()) return nullptr;
    string codigo = leerTexto("Codigo del centro: ");
    CentroDistribucion* centro = sistema->buscarCentro(codigo);
    if (centro == nullptr) cout << "Centro no encontrado." << endl;
    return centro;
}

Colaborador* Menu::seleccionarColaborador(CentroDistribucion* centro) const {
    if (centro == nullptr) return nullptr;
    string identificacion = leerTexto("Identificacion del colaborador: ");
    Nodo<Colaborador>* nodo = centro->getColaboradores().getPrimero();
    while (nodo != nullptr) {
        if (nodo->getDato()->getIdentificacion() == identificacion) return nodo->getDato();
        nodo = nodo->getSiguiente();
    }
    cout << "Colaborador no encontrado." << endl;
    return nullptr;
}

void Menu::pausar() const {
    cout << "Presione ENTER para continuar..." << endl;
    cin.ignore(10000, '\n');
    cin.get();
}

